{
  "name": "claude-hq",
  "version": "0.1.0",
  "private": true,
  "description": "A local pixel-art office that shows Claude Code agents at work and lets you chat with a router agent.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "vite build && tsx src/server/main.ts",
    "dev": "tsx watch --clear-screen=false src/server/main.ts --dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.6",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@pixi/react": "^8.0.5",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.8",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
